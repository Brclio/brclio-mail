# Brclio Mail Preview deployment settings.
# Copy to .env, replace every example value, and never commit .env or secrets/.

TZ=Asia/Shanghai
BRCLIO_IMAGE=brclio-mail:preview
BRCLIO_VERSION=0.1.0-preview

# Public mail host. This must match A/AAAA, MX, PTR and the TLS certificate.
BRCLIO_HOSTNAME=mail.example.com
BRCLIO_BASE_URL=https://mail.example.com

# Option A (default): built-in ACME HTTP-01. Public TCP 80 and 443 are required.
BRCLIO_AUTO_TLS=true
BRCLIO_ACME_EMAIL=postmaster@example.com

# Option B: set AUTO_TLS=false and point both values at files mounted from
# ./secrets/tls. Never enable static and automatic TLS together.
BRCLIO_TLS_CERT=
BRCLIO_TLS_KEY=
# BRCLIO_TLS_CERT=/run/tls/fullchain.pem
# BRCLIO_TLS_KEY=/run/tls/privkey.pem

# First-run and relay secrets are files, not values in this environment file.
BRCLIO_SETUP_TOKEN_FILE=./secrets/setup_token
BRCLIO_RELAY_PASSWORD_FILE=./secrets/relay_password

# Recommended production path: authenticated smarthost. Fill these with the
# provider's real values; common examples are 465 + true or 587 + false.
BRCLIO_RELAY_ADDR=
BRCLIO_RELAY_USERNAME=
BRCLIO_RELAY_IMPLICIT_TLS=false
# BRCLIO_RELAY_ADDR=smtp.provider.example:465
# BRCLIO_RELAY_USERNAME=account@example.com
# BRCLIO_RELAY_IMPLICIT_TLS=true

# Experimental direct MX delivery is deliberately disabled by default.
BRCLIO_DIRECT_DELIVERY=false

BRCLIO_MAX_MESSAGE_BYTES=26214400
BRCLIO_MAX_ARCHIVE_BYTES=107374182400
BRCLIO_MIN_FREE_DISK_BYTES=1073741824
BRCLIO_SESSION_TTL=168h
BRCLIO_QUEUE_POLL_INTERVAL=30s
BRCLIO_QUEUE_MAX_ATTEMPTS=12
