# Brclio Mail bare-metal production configuration.
# Installed as /etc/brclio-mail/brclio-mail.env (root:root, mode 0600).
# Keep values unquoted and do not put passwords directly in this file.

BRCLIO_DATA_DIR=/var/lib/brclio-mail
BRCLIO_DATABASE_PATH=/var/lib/brclio-mail/brclio-mail.db

# Public listeners. systemd grants only CAP_NET_BIND_SERVICE so the unprivileged
# service account can bind these ports.
BRCLIO_HTTP_ADDR=:80
BRCLIO_HTTPS_ADDR=:443
BRCLIO_ACME_HTTP_ADDR=:80
BRCLIO_SMTP_ADDR=:25
BRCLIO_SMTPS_ADDR=:465
BRCLIO_SUBMISSION_ADDR=:587
BRCLIO_IMAP_ADDR=
BRCLIO_IMAPS_ADDR=:993

BRCLIO_HOSTNAME=mail.example.com
BRCLIO_BASE_URL=https://mail.example.com

# Recommended for a dedicated server with public 80/443 and matching DNS.
BRCLIO_AUTO_TLS=true
BRCLIO_ACME_EMAIL=postmaster@example.com
# Static TLS paths are supplied through the optional systemd credential
# drop-in, never directly from this environment file.

# systemd LoadCredential supplies the setup and relay secret file variables.

# Recommended outbound mode for personal and small-company installations.
BRCLIO_RELAY_ADDR=
BRCLIO_RELAY_USERNAME=
BRCLIO_RELAY_IMPLICIT_TLS=false
BRCLIO_DIRECT_DELIVERY=false

BRCLIO_DEV_MODE=false
BRCLIO_DISABLE_MAIL_SERVERS=false
BRCLIO_MAX_MESSAGE_BYTES=26214400
BRCLIO_MAX_ARCHIVE_BYTES=107374182400
BRCLIO_MIN_FREE_DISK_BYTES=1073741824
BRCLIO_SESSION_TTL=168h
BRCLIO_QUEUE_POLL_INTERVAL=30s
BRCLIO_QUEUE_MAX_ATTEMPTS=12
BRCLIO_BACKUP_TIMEOUT=2h
